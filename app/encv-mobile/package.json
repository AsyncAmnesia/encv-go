{
  "name": "encv-go-mobile",
  "version": "1.0.0",
  "description": "ENCV-go Mobile Frontend (Capacitor + Ionic Vue)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "capacitor:copy:after": "node scripts/sync-native.mjs",
    "check:kotlin": "node scripts/check-kotlin.mjs",
    "sync:android": "node scripts/sync-native.mjs",
    "rebuild:android": "echo 'To rebuild android/ from scratch: rm -rf android && npx cap add android && npx cap sync android && npx @trapezedev/configure run trapeze.yaml --android-project android'"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@ionic/vue": "^8.8.7",
    "@ionic/vue-router": "^8.8.7",
    "artplayer": "^5.4.0",
    "ionicons": "^8.0.13",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vue-tsc": "^2.2.10"
  }
}
