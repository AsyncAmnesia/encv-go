{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Soltus/encv-go/internal/config/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "properties": {
        "password": {
          "type": "string",
          "description": "--- 全局设置 ---\nPassword 用于加密和解密视频文件，请务必设置一个强密码。"
        },
        "recover": {
          "type": "boolean",
          "description": "Recover 在解密时是否尝试覆盖已有文件。"
        },
        "output_path": {
          "type": "string",
          "description": "--- 加密/解密设置 ---\nOutputPath 加密后的文件输出目录。"
        },
        "track_extensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "TrackExtensions 视频容器的字幕/轨道文件扩展名列表，它们并不会打包到容器里。"
        },
        "plugin_settings": {
          "properties": {
            "video": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/video/video-plugin-config",
              "$ref": "#/$defs/VideoPluginConfig",
              "$defs": {
                "VideoPluginConfig": {
                  "properties": {
                    "ext": {
                      "type": "string"
                    },
                    "chunk_size_mb": {
                      "type": "integer"
                    },
                    "light_main_chunk_enabled": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "ext",
                    "chunk_size_mb",
                    "light_main_chunk_enabled"
                  ]
                }
              }
            },
            "image": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/image/image-plugin-config",
              "$ref": "#/$defs/ImagePluginConfig",
              "$defs": {
                "ImagePluginConfig": {
                  "properties": {
                    "ext": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "ext"
                  ]
                }
              }
            },
            "wps": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/wps/wps-plugin-config",
              "$ref": "#/$defs/WPSPluginConfig",
              "$defs": {
                "WPSPluginConfig": {
                  "properties": {
                    "ext": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "ext"
                  ]
                }
              }
            },
            "pdf": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/pdf/pdf-plugin-config",
              "$ref": "#/$defs/PDFPluginConfig",
              "$defs": {
                "PDFPluginConfig": {
                  "properties": {
                    "ext": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "ext"
                  ]
                }
              }
            },
            "text": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/text/text-plugin-config",
              "$ref": "#/$defs/TextPluginConfig",
              "$defs": {
                "TextPluginConfig": {
                  "properties": {
                    "ext": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "ext"
                  ]
                }
              }
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "插件专属配置。键是插件名，值是该插件的配置对象。"
        },
        "server": {
          "$ref": "#/$defs/HttpServer",
          "description": "SccgvSettings SCCGV (视频分片) 相关的设置。\nSccgvSettings SccgvSettings             `json:\"sccgv_settings\"`"
        },
        "webdav": {
          "$ref": "#/$defs/WebdavServer"
        },
        "proxy": {
          "$ref": "#/$defs/OpenlistProxyServer"
        },
        "$schema": {
          "type": "string",
          "format": "uri",
          "description": "The JSON Schema file for validation, used by editors."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "password",
        "recover",
        "output_path",
        "track_extensions",
        "plugin_settings",
        "server",
        "webdav",
        "proxy"
      ],
      "description": "Config 是应用程序的顶层配置结构，包含所有子模块的配置。"
    },
    "HttpServer": {
      "properties": {
        "port": {
          "type": "integer",
          "description": "encv HTTP 服务器的端口，请不要填写 encv Webdav Server、 OpenList 或其他已使用的端口"
        },
        "dir": {
          "type": "string",
          "description": "文件系统的根目录（例如 /path/to/your/files），支持相对路径"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "port",
        "dir"
      ],
      "description": "--- 内置HTTP服务器 设置 ---"
    },
    "OpenlistProxyServer": {
      "properties": {
        "port": {
          "type": "integer",
          "description": "Openlist Webdav 代理的端口，请不要填写 encv Webdav Server、 OpenList 或其他已使用的端口"
        },
        "openlist_host": {
          "type": "string",
          "description": "OpenList 的主机名，一般是 IP 或者域名，比如 localhost"
        },
        "token": {
          "type": "string",
          "description": "不建议在 json 文件中存储 Token"
        },
        "disable_signature_verification": {
          "type": "boolean",
          "description": "禁用签名，目前没发现这个值有什么影响"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "port",
        "openlist_host",
        "token",
        "disable_signature_verification"
      ],
      "description": "--- Openlist 代理服务器设置 ---"
    },
    "WebdavServer": {
      "properties": {
        "port": {
          "type": "integer",
          "description": "encv Webdav 服务器的端口，请不要填写 encv HTTP Server、 OpenList 或其他已使用的端口"
        },
        "root": {
          "type": "string",
          "description": "路由（例如 /webdav/）"
        },
        "dir": {
          "type": "string",
          "description": "文件系统的根目录（例如 /path/to/your/files），而不是 WebDAV 的路由前缀（例如 /webdav/）"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "port",
        "root",
        "dir"
      ],
      "description": "--- WebDAV 服务器设置 ---"
    }
  }
}