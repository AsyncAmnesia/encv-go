{
  "$schema": "https://raw.githubusercontent.com/Soltus/encv-go/main/config.schema.json",
  "admin": {
    "password": "123456"
  },
  "agent_settings": {
    "openai_api_key": "sk-fctGwMohd9gsrEHVtfIsJe1Y8sucQH7QmRDbGCNURWmSXxWG"
  },
  "default_container_version": 0,
  "log": {
    "file": "encv.log",
    "level": "info"
  },
  "mobile": {
    "output": {
      "path": "/storage/emulated/0/encv-output"
    },
    "server": {
      "dir": "/storage/emulated/0"
    },
    "webdav": {
      "dir": ""
    }
  },
  "output_path": "./output",
  "password": "my-encv_key，可以使用中文和标点符号✔",
  "plugin_settings": {
    "alist_encrypt": {
      "default_password": "123456",
      "enabled": true,
      "suffix": ".bin"
    },
    "audio": {
      "ext": ".sccga"
    },
    "image": {
      "ext": ".sccgi"
    },
    "pdf": {
      "ext": ".sccgpdf"
    },
    "text": {
      "ext": ".sccgt"
    },
    "video": {
      "allow_no_reencode": true,
      "chunk_size_mb": 0,
      "ext": ".sccgv",
      "keep_mkv_for_mkv_source": true,
      "light_container_main_chunk_enabled": true,
      "light_main_chunk_enabled": true,
      "skip_merge_for_split_mkv": false,
      "track_extensions": ".ass,.srt,.dm.ass,.vtt",
      "verify_after_pack": true
    },
    "wps": {
      "ext": ".sccgwps"
    }
  },
  "proxy": {
    "disable_signature_verification": false,
    "sites": {
      "pc": {
        "description": "电脑上的openlist",
        "host": "http://localhost:5244"
      },
      "pc_dev": {
        "description": "电脑上定制版的openlist",
        "host": "http://localhost:5234"
      },
      "vivo": {
        "description": "手机上的openlist",
        "host": "http://192.168.31.19:5244"
      }
    }
  },
  "recover": false,
  "server": {
    "dir": "/",
    "port": 2025
  },
  "strict_deprecated_version": false,
  "webdav": {
    "dir": "./output",
    "password": "123456",
    "root": "/webdav/",
    "username": "admin"
  }
}
