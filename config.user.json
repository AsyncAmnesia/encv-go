{
  "$schema": "https://raw.githubusercontent.com/Soltus/encv-go/main/config.schema.json",
  "password": "my-encv_key，可以使用中文和标点符号✔",
  "output_path": "./output",
  "server": {
    "port": 2025,
    "dir": "/"
  },
  "proxy": {
    "port": 1998,
    "openlist_host": "http://localhost:5244"
  },
  "webdav": {
    "port": 1234,
    "root": "webdav",
    "dir": "./"
  },
  "plugin_settings": {
    "video": {
      "ext": ".sccgv",
      "chunk_size_mb": 100,
      "track_extensions": [".ass", ".srt", ".dm.ass", ".vtt"]
    },
    "image": {"ext": ".sccgi"},
    "audio": {"ext": ".sccga"},
    "text": {"ext": ".sccgt"},
    "wps": {"ext": ".sccgwps"},
    "pdf": {"ext": ".sccgpdf"}
  }
}
